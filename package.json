{
  "name": "@iovi/agent-kit",
  "version": "0.1.0",
  "description": "Headless TypeScript SDK and CLI for AI agents using IOVI/EON semantic-layer services.",
  "type": "module",
  "bin": {
    "iovi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
